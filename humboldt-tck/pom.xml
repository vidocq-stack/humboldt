<?xml version="1.0" encoding="UTF-8"?>
<!--
    In-reactor TCK runner, gated by the `tck` Maven profile of humboldt-parent
    (TCK harmonisation — same pattern as the vidocq-runtime-tck-* runners and
    the dirac pilot): a plain `mvn install` neither downloads nor runs anything
    TCK-related.

    History: this module used to be a STANDALONE out-of-reactor POM to work
    around ShrinkWrap Maven Resolver 3.3 (could not parse Model 4.1.0 POMs).
    That constraint disappeared with the Maven 3.9.16 / Model 4.0.0 migration.

    Execution goes through the script (thin wrapper over the reactor):
        ./run-official-tck-telemetry-2.2.sh              # smoke
        ./run-official-tck-telemetry-2.2.sh all          # full suite
        ./run-official-tck-telemetry-2.2.sh -Dtest=...   # targeted class

    Or directly:
        ./mvnw -Ptck,tck-smoke -pl humboldt-tck test     # smoke
        ./mvnw -Ptck,tck-official -pl humboldt-tck test  # full suite
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.humboldt</groupId>
        <artifactId>humboldt-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>humboldt-tck</artifactId>
    <packaging>jar</packaging>

    <name>Humboldt :: TCK Runner</name>
    <description>Harness de conformance MicroProfile Telemetry 2.2 — TCK officiel Eclipse (Tracing + Metrics + Logs).</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>

        <humboldt.version>0.4.0-SNAPSHOT</humboldt.version>
        <vauban.version>0.4.0-SNAPSHOT</vauban.version>
        <cassini.version>0.4.0-SNAPSHOT</cassini.version>
        <chappe.version>0.4.0-SNAPSHOT</chappe.version>

        <microprofile.telemetry.version>2.2-RC3</microprofile.telemetry.version>
        <microprofile.config.version>3.1.1</microprofile.config.version>
        <microprofile.rest.client.version>4.0</microprofile.rest.client.version>
        <opentelemetry.version>1.66.0</opentelemetry.version>
        <opentelemetry.instrumentation.version>2.31.1</opentelemetry.instrumentation.version>
        <opentelemetry.semconv.version>1.44.0</opentelemetry.semconv.version>

        <arquillian.version>1.8.0.Final</arquillian.version>
        <shrinkwrap.resolver.version>3.3.0</shrinkwrap.resolver.version>
        <testng.version>7.10.2</testng.version>
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>
        <jakarta.ws.rs.version>4.0.0</jakarta.ws.rs.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>

        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <maven.surefire.version>3.5.5</maven.surefire.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>${opentelemetry.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.jboss.arquillian</groupId>
                <artifactId>arquillian-bom</artifactId>
                <version>${arquillian.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.jboss.shrinkwrap.resolver</groupId>
                <artifactId>shrinkwrap-resolver-bom</artifactId>
                <version>${shrinkwrap.resolver.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ============================================================ -->
        <!--  TCK officiels (publics sur Maven Central)                   -->
        <!-- ============================================================ -->
        <dependency>
            <groupId>org.eclipse.microprofile.telemetry</groupId>
            <artifactId>microprofile-telemetry-tracing-tck</artifactId>
            <version>${microprofile.telemetry.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.telemetry</groupId>
            <artifactId>microprofile-telemetry-metrics-tck</artifactId>
            <version>${microprofile.telemetry.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.telemetry</groupId>
            <artifactId>microprofile-telemetry-logs-tck</artifactId>
            <version>${microprofile.telemetry.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ============================================================ -->
        <!--  Humboldt runtime + SDK (à tester contre le TCK)             -->
        <!-- ============================================================ -->
        <dependency>
            <groupId>io.vidocq.humboldt</groupId>
            <artifactId>humboldt-runtime</artifactId>
            <version>${humboldt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.humboldt</groupId>
            <artifactId>humboldt-cdi</artifactId>
            <version>${humboldt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.humboldt</groupId>
            <artifactId>humboldt-rest</artifactId>
            <version>${humboldt.version}</version>
        </dependency>

        <!-- ============================================================ -->
        <!--  Vauban CDI Lite — container utilisé par le container        -->
        <!--  Arquillian Humboldt pour booter les beans du war ShrinkWrap -->
        <!-- ============================================================ -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
            <version>${vauban.version}</version>
        </dependency>

        <!-- ============================================================ -->
        <!--  M7c.2 : Chappe HTTP + Cassini JAX-RS — assemblés in-process -->
        <!--  par le container Arquillian pour les tests TCK REST.        -->
        <!-- ============================================================ -->
        <dependency>
            <groupId>io.vidocq.chappe</groupId>
            <artifactId>chappe-api</artifactId>
            <version>${chappe.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.chappe</groupId>
            <artifactId>chappe-core</artifactId>
            <version>${chappe.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.chappe</groupId>
            <artifactId>chappe-http</artifactId>
            <version>${chappe.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-api</artifactId>
            <version>${cassini.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-core</artifactId>
            <version>${cassini.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-chappe</artifactId>
            <version>${cassini.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-cdi-vauban</artifactId>
            <version>${cassini.version}</version>
        </dependency>
        <!-- ============================================================ -->
        <!--  M7c.6 — Cassini JAX-RS Client (jakarta.ws.rs.client.*)      -->
        <!--  Débloque BaggageTest, RestClientSpan*Test, etc. qui font    -->
        <!--  ClientBuilder.newClient().target(...).request().get().      -->
        <!--  Fournit aussi un RuntimeDelegate provider (autonome).       -->
        <!-- ============================================================ -->
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-client</artifactId>
            <version>${cassini.version}</version>
        </dependency>

        <!-- ============================================================ -->
        <!--  Annotation @WithSpan OFFICIELLE attendue par le TCK         -->
        <!--  (différente de notre humboldt-cdi WithSpan — voir TCK.md)   -->
        <!-- ============================================================ -->
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-instrumentation-annotations</artifactId>
            <version>${opentelemetry.instrumentation.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ============================================================ -->
        <!--  Specs Jakarta + MicroProfile requises par le TCK            -->
        <!-- ============================================================ -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <version>${jakarta.cdi.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <version>${jakarta.ws.rs.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>${jakarta.annotation.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
            <version>${microprofile.config.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.rest.client</groupId>
            <artifactId>microprofile-rest-client-api</artifactId>
            <version>${microprofile.rest.client.version}</version>
        </dependency>

        <!-- ============================================================ -->
        <!--  Cyrano — implémentation MicroProfile Rest Client 4.0        -->
        <!--  pour que RestClientBuilder.newBuilder() retourne une impl   -->
        <!--  concrète (TCK MP Telemetry RestClientSpan*Test, W3*Test).   -->
        <!--  Cyrano fournit RestClientBuilderResolver via ServiceLoader. -->
        <!-- ============================================================ -->
        <dependency>
            <groupId>io.vidocq.cyrano</groupId>
            <artifactId>cyrano-api</artifactId>
            <version>0.4.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cyrano</groupId>
            <artifactId>cyrano-core</artifactId>
            <version>0.4.0-SNAPSHOT</version>
        </dependency>

        <!-- ============================================================ -->
        <!--  OTel SDK officiel — utilisé par le TCK pour ses fixtures.   -->
        <!--  Hors-Humboldt-prod : ne pollue pas le runtime applicatif.   -->
        <!-- ============================================================ -->
        <!-- Compile scope on purpose: the bridge in humboldt-tck/src/main (OtelSpanExporterBridge,
             SpanDataMapper) imports io.opentelemetry.sdk.*, so the SDK artifacts below cannot be test scope.
             Only semconv and instrumentation-annotations (unused by src/main) are test scope. -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-extension-autoconfigure</artifactId>
        </dependency>
        <!-- Propagateurs B3 (single+multi) et Jaeger — utilisés par B3PropagationTest,
             B3MultiPropagationTest, JaegerPropagationTest. Disponibles via la
             dépendance officielle opentelemetry-extension-trace-propagators (BOM
             OTel l'expose). Câblés comme builtins dans resolveSpiPropagators. -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-extension-trace-propagators</artifactId>
        </dependency>
        <!-- TestSpanData.builder() — fournit l'impl concrète io.opentelemetry.sdk.trace.data.SpanData
             utilisée par le bridge humboldt-tck pour convertir nos humboldt.SpanData vers le format
             OTel SDK attendu par les exporters fournis par le TCK (InMemorySpanExporter, etc.). -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-testing</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry.semconv</groupId>
            <artifactId>opentelemetry-semconv</artifactId>
            <version>${opentelemetry.semconv.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ============================================================ -->
        <!--  Test infrastructure : TestNG + Arquillian + ShrinkWrap      -->
        <!-- ============================================================ -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ============================================================ -->
        <!--  M7c.4 : force commons-io 2.16 — la version 2.11 tirée par   -->
        <!--  awaitility 4.3 (transitive depuis le TCK metrics) n'a pas   -->
        <!--  Tailer.builder() utilisé par JvmMemoryTest/JvmThreadTest/    -->
        <!--  JvmCpuTest. Bump débloque 24 tests.                          -->
        <!-- ============================================================ -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.16.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.arquillian.testng</groupId>
            <artifactId>arquillian-testng-container</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.shrinkwrap</groupId>
            <artifactId>shrinkwrap-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.shrinkwrap.resolver</groupId>
            <artifactId>shrinkwrap-resolver-impl-maven</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.shrinkwrap.resolver</groupId>
            <artifactId>shrinkwrap-resolver-api-maven</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <release>25</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.version}</version>
                <configuration>
                    <!-- TCK = TestNG, pas JUnit. Activé via le runtime testng -->
                    <useSystemClassLoader>false</useSystemClassLoader>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Profile par défaut : tous les tests Humboldt-tck locaux
             (HumboldtTckSmokeTest, bridge tests, Arquillian boot smoke, etc.)
             sans exécuter les vraies suites TCK officielles (réservées au
             profile tck-official). -->
        <profile>
            <id>tck-smoke</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
        </profile>

        <!-- Profile ciblé : exécute UNIQUEMENT OpenTelemetryBeanTest du TCK tracing.
             Utilisé en M7b.5 pour valider que la chaîne Arquillian → HumboldtContainer
             → Vauban CDI → @Inject OpenTelemetry fonctionne sur un test TCK officiel,
             sans encore viser le passage de la suite complète. -->
        <profile>
            <id>tck-cdi-bean</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <dependenciesToScan>
                                <dependency>org.eclipse.microprofile.telemetry:microprofile-telemetry-tracing-tck</dependency>
                            </dependenciesToScan>
                            <test>OpenTelemetryBeanTest</test>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Profile complet : exécute toute la suite TCK officielle. -->
        <profile>
            <id>tck-official</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <suiteXmlFiles>
                                <suiteXmlFile>src/test/resources/tck-suite.xml</suiteXmlFile>
                            </suiteXmlFiles>
                            <dependenciesToScan>
                                <dependency>org.eclipse.microprofile.telemetry:microprofile-telemetry-tracing-tck</dependency>
                                <dependency>org.eclipse.microprofile.telemetry:microprofile-telemetry-metrics-tck</dependency>
                                <dependency>org.eclipse.microprofile.telemetry:microprofile-telemetry-logs-tck</dependency>
                            </dependenciesToScan>
                            <systemPropertyVariables>
                                <!-- SPI de "porting" du TCK MP Telemetry 2.2 —
                                     JaxRsServerAsyncTestEndpoint fait
                                     `ConfigurationAccessor.get().getExecutor()` dans
                                     son constructeur. Sans cette property,
                                     l'instantiation échoue avec "Cannot find any
                                     implementations of Executor, check that
                                     telemetry.tck.executor is specified". -->
                                <telemetry.tck.executor>io.vidocq.humboldt.tck.HumboldtTckExecutor</telemetry.tck.executor>
                                <!-- MP Telemetry Logs TCK (JulTest) lit cette property dans son
                                     static{} pour ouvrir le fichier de log à vérifier. Le
                                     LoggingLogRecordExporter Humboldt y écrit chaque LogRecord
                                     quand OTEL_LOGS_EXPORTER=logging. -->
                                <mptelemetry.tck.log.file.path>${project.build.directory}/humboldt-tck-logs.txt</mptelemetry.tck.log.file.path>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
