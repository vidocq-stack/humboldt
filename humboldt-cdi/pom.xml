<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.humboldt</groupId>
        <artifactId>humboldt-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>humboldt-cdi</artifactId>
    <name>Humboldt :: CDI</name>
    <description>Interceptor CDI Lite : auto-applique l'interception sur @WithSpan OpenTelemetry via BuildCompatibleExtension. Compatible Vauban CDI 4.1 Lite. Pas de dep Weld.</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.humboldt</groupId>
            <artifactId>humboldt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.humboldt</groupId>
            <artifactId>humboldt-sdk-trace</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.humboldt</groupId>
            <artifactId>humboldt-otel-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.humboldt</groupId>
            <artifactId>humboldt-otel-context</artifactId>
        </dependency>
        <!--
            Standard public OTel @WithSpan annotation: the annotation expected by
            MicroProfile Telemetry 2.2 and its TCK. API/SPI only, no runtime
            implementation (marker annotations only).
        -->
        <dependency>
            <groupId>io.vidocq.humboldt</groupId>
            <artifactId>humboldt-otel-instrumentation-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
        <!-- CDI API tire jakarta.interceptor-api en transitive. -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>
        <!-- Compile-only: supplies the VaubanComponentProvider service type referenced by the
             APT-generated _VaubanComponents. Provided scope: no runtime dependency on Vauban. -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-api</artifactId>
            <version>${vauban.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Vauban codegen runs as an ANNOTATION PROCESSOR on this module's own beans (the Maven
                plugin is reserved for freezing external, non-APT-processed dependency jars). During
                the main compile it generates _ClientProxy/_Factory, META-INF/vauban-beans.list
                (runtime discovery, both class path and module path), and one _VaubanComponents per
                package (in-module instantiation / field-injection / producer invocation, no
                `opens … to io.vidocq.vauban.core`). Build-time only: adds no compile/runtime
                dependency on Vauban, and the output stays inert for a standard CDI container (Weld).

                The module-info lives in src/main/module-info/ and is compiled in a separate step
                (vauban is not on this module's runtime path; keeping module-info.class out of
                target/classes during testCompile prevents Maven from activating Java Modules and failing
                to resolve the test modules — same workaround as ravel-cdi-vauban / knock-cdi-vauban).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <!-- Runs before default-compile (process-resources is the phase right before
                         compile): removes any module-info.class left in target/classes by a prior
                         build's compile-module-info (prepare-package) step. Without this, a no-clean
                         `mvn install` (as the TCK runner does) would let javac detect the stale
                         module descriptor and switch default-compile to module mode, failing to
                         resolve the dependency modules. -->
                    <execution>
                        <id>remove-stale-module-info</id>
                        <phase>process-resources</phase>
                        <goals><goal>clean</goal></goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.outputDirectory}</directory>
                                    <includes>
                                        <include>module-info.class</include>
                                    </includes>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Vauban APT processes this module's own beans at compile time. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.vidocq.vauban</groupId>
                            <artifactId>vauban-processor</artifactId>
                            <version>${vauban.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <!-- Test fixtures are not application beans (the unit test exercises the
                         interceptor directly, no container). Running the APT over them would emit
                         a provider for nested test classes (bogus package / cannot find symbol). -->
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <proc>none</proc>
                        </configuration>
                    </execution>
                    <execution>
                        <id>compile-module-info</id>
                        <phase>prepare-package</phase>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <!-- No annotation processing on the separate module-info compile
                                 (the beans were already processed in the main compile). -->
                            <proc>none</proc>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/main/module-info</compileSourceRoot>
                            </compileSourceRoots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
