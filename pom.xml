<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd"
         root="true">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>io.vidocq</groupId>
        <artifactId>vidocq-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>io.vidocq.humboldt</groupId>
    <artifactId>humboldt-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Humboldt</name>
    <description>Implémentation MicroProfile Telemetry 2.1 — tracing/metrics/logs OpenTelemetry-native, JPMS strict, zéro SDK tiers, Java 25.</description>
    <url>https://codeberg.org/Vidocq/humboldt</url>

    <developers>
        <developer>
            <name>Yann Blazart</name>
            <email>yann.blazart@gmail.com</email>
        </developer>
    </developers>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://codeberg.org/Vidocq/humboldt.git</connection>
        <developerConnection>scm:git:ssh://git@forge.vidocq.dev:vidocq/humboldt.git</developerConnection>
        <url>https://codeberg.org/Vidocq/humboldt</url>
    </scm>

    <properties>
        <!-- Specs -->
        <microprofile.telemetry.version>2.1</microprofile.telemetry.version>
        <opentelemetry.version>1.39.0</opentelemetry.version>
        <opentelemetry.semconv.version>1.27.0-alpha</opentelemetry.semconv.version>
        <opentelemetry.instrumentation.version>2.7.0</opentelemetry.instrumentation.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>
        <jakarta.ws.rs.version>4.0.0</jakarta.ws.rs.version>

        <!-- Vidocq ecosystem -->
        <chappe.version>0.1.0-SNAPSHOT</chappe.version>
        <vauban.version>0.1.0-SNAPSHOT</vauban.version>
        <champollion.version>0.1.0-SNAPSHOT</champollion.version>
        <ravel.version>0.1.0-SNAPSHOT</ravel.version>
    </properties>

    <subprojects>
        <subproject>humboldt-api</subproject>
        <subproject>humboldt-otel-context</subproject>
        <subproject>humboldt-otel-api</subproject>
        <subproject>humboldt-otel-instrumentation-annotations</subproject>
        <subproject>humboldt-sdk-common</subproject>
        <subproject>humboldt-context</subproject>
        <subproject>humboldt-sdk-trace</subproject>
        <subproject>humboldt-propagator-w3c</subproject>
        <subproject>humboldt-exporter-otlp-http</subproject>
        <subproject>humboldt-sdk-metric</subproject>
        <subproject>humboldt-sdk-log</subproject>
        <subproject>humboldt-cdi</subproject>
        <subproject>humboldt-rest</subproject>
        <subproject>humboldt-runtime</subproject>
    </subprojects>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>${opentelemetry.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>io.opentelemetry.semconv</groupId>
                <artifactId>opentelemetry-semconv</artifactId>
                <version>${opentelemetry.semconv.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry.instrumentation</groupId>
                <artifactId>opentelemetry-instrumentation-annotations</artifactId>
                <version>${opentelemetry.instrumentation.version}</version>
            </dependency>

            <dependency>
                <groupId>org.eclipse.microprofile.telemetry</groupId>
                <artifactId>microprofile-telemetry-api</artifactId>
                <version>${microprofile.telemetry.version}</version>
            </dependency>

            <dependency>
                <groupId>jakarta.annotation</groupId>
                <artifactId>jakarta.annotation-api</artifactId>
                <version>${jakarta.annotation.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>${jakarta.cdi.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.ws.rs</groupId>
                <artifactId>jakarta.ws.rs-api</artifactId>
                <version>${jakarta.ws.rs.version}</version>
            </dependency>

            <!-- Vidocq -->
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-otel-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-otel-context</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-otel-instrumentation-annotations</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-sdk-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-context</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-sdk-trace</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-propagator-w3c</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-exporter-otlp-http</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-sdk-metric</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-sdk-log</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-cdi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-rest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-runtime</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
