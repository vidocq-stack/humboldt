<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.humboldt</groupId>
        <artifactId>humboldt-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>humboldt-rest</artifactId>
    <name>Humboldt :: REST</name>
    <description>Filters JAX-RS pour instrumentation HTTP serveur : extract W3C TraceContext, span SERVER, conventions OTel HTTP semantic.</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.humboldt</groupId>
            <artifactId>humboldt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.humboldt</groupId>
            <artifactId>humboldt-sdk-trace</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.humboldt</groupId>
            <artifactId>humboldt-propagator-w3c</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.humboldt</groupId>
            <artifactId>humboldt-otel-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.humboldt</groupId>
            <artifactId>humboldt-otel-context</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
        </dependency>
        <!-- CDI scope annotations on the server filters (provided: the runtime brings CDI). -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <version>4.1.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- M7c.12 — MicroProfile Rest Client API: provided scope.
             HumboldtMpRestClientListener is only invoked when MP Rest Client is
             actually present at runtime (typically through cyrano-core on the
             application class path). It enables auto-instrumentation of the Rest Clients
             created through @RegisterRestClient/RestClientBuilder.
             Provided scope rather than optional=true so that default-testCompile also
             sees the microprofile.rest.client.api module (requires static in the
             main module-info), otherwise `module not found` in testCompile under
             maven-compiler-plugin 4.0.0-beta-4. provided = visible at compile+test,
             absent from the published runtime class path — functionally equivalent to optional. -->
        <dependency>
            <groupId>org.eclipse.microprofile.rest.client</groupId>
            <artifactId>microprofile-rest-client-api</artifactId>
            <version>4.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- jakarta.annotation for @Priority on HumboldtSpanFinalizer.
             Small standard API dependency, required by the JAX-RS semantics for
             ExceptionMapper priorities. -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
        <!--
            Vauban SPI (provided): the Vauban APT below generates the
            _VaubanComponents provider so the @Provider filters self-register as
            CDI beans in a Vauban-based runtime (same pattern as knock-jaxrs) —
            without it the assembled Vidocq runtime never discovers the JAX-RS
            tracing filters.
        -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-api</artifactId>
            <version>${vauban.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
            Java Modules workaround aligned with cyrano-core (see cyrano/cyrano-core/pom.xml).

            Problem: maven-compiler-plugin 4.0.0-beta-4 detects Java Modules mode as soon as
            module-info.class is present in target/classes. In Java Modules mode for
            testCompile, it rebuilds a module path that ignores the custom -p and
            fails on `module not found: microprofile.rest.client.api` (JAR without
            Automatic-Module-Name).

            Solution:
            1. module-info.java moved out of src/main/java (into src/main/module-info):
               default-compile does not see it → no module-info.class in
               target/classes → Maven does not detect Java Modules for testCompile, which
               runs on the plain class path.
            2. maven-clean-plugin (generate-test-sources) removes any stale
               module-info.class before testCompile.
            3. maven-compiler-plugin (prepare-package) recompiles module-info.java alone
               into target/classes before the JAR is assembled.
            4. surefire with useModulePath=false to stay aligned on the class path in tests.

            The main code still compiles on the class path (no visible module-info) — this is
            allowed because the types used are exported by their respective modules and
            the unnamed module is relied upon for resolution.
        -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>remove-module-info-before-testcompile</id>
                        <phase>generate-test-sources</phase>
                        <goals><goal>clean</goal></goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.outputDirectory}</directory>
                                    <includes>
                                        <include>module-info.class</include>
                                    </includes>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <!-- Copies all dependencies (incl. provided microprofile-rest-client-api)
                         into target/javamodules so that javac can derive the module name
                         from the file name. Phase initialize: available
                         at default-compile (Java Modules dependencies force module-path mode)
                         and at compile-module-info in prepare-package. -->
                    <execution>
                        <id>copy-deps-to-module-path</id>
                        <phase>initialize</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/javamodules</outputDirectory>
                            <includeScope>test</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- -p javamodules applied to all executions unless overridden.
                         Needed because maven-compiler-plugin 4.0.0-beta-4 enables
                         Java Modules mode as soon as a dependency is a named module (humboldt-api etc.) — it
                         must then be told where to find microprofile-rest-client-api
                         (JAR without Automatic-Module-Name, copied by the dependency plugin). -->
                    <compilerArgs>
                        <arg>-p</arg>
                        <arg>${project.build.directory}/javamodules</arg>
                        <!-- Library module: cross-module beans are validated at the
                             Vidocq runtime assembly, not here (pattern knock-jaxrs). -->
                        <arg>-Avauban.validation=false</arg>
                    </compilerArgs>
                    <!-- Vauban indexer APT: generates META-INF/vauban-beans.list and the
                         _VaubanComponents provider so the @Provider tracing filters
                         self-register as CDI beans in a Vauban-based runtime. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.vidocq.vauban</groupId>
                            <artifactId>vauban-processor</artifactId>
                            <version>${vauban.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <execution>
                        <id>compile-module-info</id>
                        <phase>prepare-package</phase>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/main/module-info</compileSourceRoot>
                            </compileSourceRoots>
                            <compilerArgs>
                                <arg>-p</arg>
                                <arg>${project.build.directory}/javamodules</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
