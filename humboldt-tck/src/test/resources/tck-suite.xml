<?xml version="1.0" encoding="UTF-8"?>
<!--
    TestNG suite aggregating the 3 MicroProfile Telemetry 2.2 TCKs.
    Enabled through the -Ptck-official profile.

    Historical note (M7 scaffold): none of these tests passed at first; the
    Humboldt Arquillian adapter (Vauban+Cassini+Chappe) arrived in M7b.
-->
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="microprofile-telemetry-tck-2.2" verbose="2" configfailurepolicy="continue">
    <test name="microprofile-telemetry-tracing-tck">
        <packages>
            <package name="org.eclipse.microprofile.telemetry.tracing.tck.*"/>
        </packages>
    </test>
    <test name="microprofile-telemetry-metrics-tck">
        <packages>
            <package name="org.eclipse.microprofile.telemetry.metrics.tck.*"/>
        </packages>
    </test>
    <test name="microprofile-telemetry-logs-tck">
        <packages>
            <package name="org.eclipse.microprofile.telemetry.logs.tck.*"/>
        </packages>
    </test>
</suite>
