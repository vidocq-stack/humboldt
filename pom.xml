            <name>GPL-2.0-or-later</name>
            <url>https://www.gnu.org/licenses/old-licenses/gpl-2.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://codefloe.com/Vidocq/humboldt.git</connection>
        <developerConnection>scm:git:ssh://git@forge.vidocq.dev:vidocq/humboldt.git</developerConnection>
        <url>https://codefloe.com/Vidocq/humboldt</url>
    </scm>

    <properties>
        <!-- Specs -->
        <microprofile.telemetry.version>2.1</microprofile.telemetry.version>
        <opentelemetry.version>1.39.0</opentelemetry.version>
        <opentelemetry.semconv.version>1.27.0-alpha</opentelemetry.semconv.version>
        <opentelemetry.instrumentation.version>2.7.0</opentelemetry.instrumentation.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>
        <jakarta.ws.rs.version>4.0.0</jakarta.ws.rs.version>

        <!-- Vidocq ecosystem -->
        <chappe.version>0.3.0-SNAPSHOT</chappe.version>
        <vauban.version>0.3.0-SNAPSHOT</vauban.version>
        <champollion.version>0.3.0-SNAPSHOT</champollion.version>
        <ravel.version>0.3.0-SNAPSHOT</ravel.version>
    </properties>

    <!--
        humboldt-tck joins the reactor only under the `tck` profile (see <profiles>
        below) — TCK harmonisation, same pattern as the vidocq-runtime-tck-*
        runners and the dirac pilot: a plain `mvn install` neither downloads nor
        runs anything TCK-related. The historical out-of-reactor constraint
        (ShrinkWrap Maven Resolver 3.3 vs Model 4.1.0 POMs) disappeared with the
        Maven 3.9.16 / Model 4.0.0 migration.
    -->
    <modules>
        <module>humboldt-api</module>
        <module>humboldt-otel-context</module>
        <module>humboldt-otel-api</module>
        <module>humboldt-otel-instrumentation-annotations</module>
        <module>humboldt-sdk-common</module>
        <module>humboldt-context</module>
        <module>humboldt-sdk-trace</module>
        <module>humboldt-propagator-w3c</module>
        <module>humboldt-exporter-otlp-http</module>
        <module>humboldt-sdk-metric</module>
        <module>humboldt-sdk-log</module>
        <module>humboldt-cdi</module>
        <module>humboldt-rest</module>
        <module>humboldt-runtime</module>
        <module>humboldt-otel-interop</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>${opentelemetry.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>io.opentelemetry.semconv</groupId>
                <artifactId>opentelemetry-semconv</artifactId>
                <version>${opentelemetry.semconv.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry.instrumentation</groupId>
                <artifactId>opentelemetry-instrumentation-annotations</artifactId>
                <version>${opentelemetry.instrumentation.version}</version>
            </dependency>

            <dependency>
                <groupId>org.eclipse.microprofile.telemetry</groupId>
                <artifactId>microprofile-telemetry-api</artifactId>
                <version>${microprofile.telemetry.version}</version>
            </dependency>

            <dependency>
                <groupId>jakarta.annotation</groupId>
                <artifactId>jakarta.annotation-api</artifactId>
                <version>${jakarta.annotation.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>${jakarta.cdi.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.ws.rs</groupId>
                <artifactId>jakarta.ws.rs-api</artifactId>
                <version>${jakarta.ws.rs.version}</version>
            </dependency>

            <!-- Vidocq -->
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-otel-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-otel-context</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-otel-instrumentation-annotations</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-sdk-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-context</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-sdk-trace</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-propagator-w3c</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-exporter-otlp-http</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-sdk-metric</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-sdk-log</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-cdi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-rest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-runtime</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.humboldt</groupId>
                <artifactId>humboldt-otel-interop</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <!--
            TCK harmonisation: the official MicroProfile Telemetry 2.1 TCK runner
            joins the reactor only when this profile is active.

                ./mvnw -Ptck,tck-smoke -pl humboldt-tck test        # smoke
                ./mvnw -Ptck,tck-official -pl humboldt-tck test     # full suite

            run-official-tck-telemetry-2.1.sh remains the friendly wrapper.
        -->
        <profile>
            <id>tck</id>
            <modules>
                <module>humboldt-tck</module>
            </modules>
        </profile>
    </profiles>
</project>
