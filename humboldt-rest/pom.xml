<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.humboldt</groupId>
        <artifactId>humboldt-parent</artifactId>
        <version>0.3.0</version>
    </parent>

    <artifactId>humboldt-rest</artifactId>
    <name>Humboldt :: REST</name>
    <description>Filters JAX-RS pour instrumentation HTTP serveur : extract W3C TraceContext, span SERVER, conventions OTel HTTP semantic.</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.humboldt</groupId>
            <artifactId>humboldt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.humboldt</groupId>
            <artifactId>humboldt-sdk-trace</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.humboldt</groupId>
            <artifactId>humboldt-propagator-w3c</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.humboldt</groupId>
            <artifactId>humboldt-otel-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.humboldt</groupId>
            <artifactId>humboldt-otel-context</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
        </dependency>
        <!-- CDI scope annotations on the server filters (provided: the runtime brings CDI). -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <version>4.1.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- M7c.12 — MicroProfile Rest Client API : scope provided.
             Le HumboldtMpRestClientListener n'est invoqué que si MP Rest Client est
             effectivement présent en runtime (typiquement via cyrano-core dans le
             classpath de l'app). Permet l'auto-instrumentation des Rest Client
             créés via @RegisterRestClient/RestClientBuilder.
             Scope provided plutôt qu'optional=true pour que default-testCompile voie
             aussi le module microprofile.rest.client.api (requires static dans le
             module-info du main), sinon `module not found` en testCompile sous
             maven-compiler-plugin 4.0.0-beta-4. provided = visible compile+test,
             absent du runtime classpath publié — équivalent fonctionnel d'optional. -->
        <dependency>
            <groupId>org.eclipse.microprofile.rest.client</groupId>
            <artifactId>microprofile-rest-client-api</artifactId>
            <version>4.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- jakarta.annotation pour @Priority sur HumboldtSpanFinalizer.
             Petite dep API standard, requise par la sémantique JAX-RS pour
             les ExceptionMapper priorités. -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
        <!--
            Vauban SPI (provided): the Vauban APT below generates the
            _VaubanComponents provider so the @Provider filters self-register as
            CDI beans in a Vauban-based runtime (same pattern as knock-jaxrs) —
            without it the assembled Vidocq runtime never discovers the JAX-RS
            tracing filters.
        -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-api</artifactId>
            <version>${vauban.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
            Java Modules workaround aligné sur cyrano-core (cf. cyrano/cyrano-core/pom.xml).

            Problème : maven-compiler-plugin 4.0.0-beta-4 détecte le mode Java Modules dès que
            module-info.class est présent dans target/classes. En mode Java Modules pour
            testCompile, il reconstruit un module-path qui ignore le -p custom et
            échoue sur `module not found: microprofile.rest.client.api` (JAR sans
            Automatic-Module-Name).

            Solution :
            1. module-info.java déplacé hors de src/main/java (dans src/main/module-info) :
               default-compile ne le voit pas → pas de module-info.class dans
               target/classes → Maven ne détecte pas Java Modules pour testCompile, qui
               s'exécute sur classpath normal.
            2. maven-clean-plugin (generate-test-sources) supprime un éventuel
               module-info.class stale avant testCompile.
            3. maven-compiler-plugin (prepare-package) recompile module-info.java seul
               dans target/classes avant l'assemblage du JAR.
            4. surefire avec useModulePath=false pour rester aligné classpath en test.

            Le code main compile reste sur classpath (sans module-info visible) — c'est
            permis car les types utilisés sont exportés par leurs modules respectifs et
            on s'appuie sur l'unnamed module pour la résolution.
        -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>remove-module-info-before-testcompile</id>
                        <phase>generate-test-sources</phase>
                        <goals><goal>clean</goal></goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.outputDirectory}</directory>
                                    <includes>
                                        <include>module-info.class</include>
                                    </includes>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <!-- Copie toutes les deps (incl. provided microprofile-rest-client-api)
                         dans target/javamodules pour que javac puisse dériver le nom de
                         module depuis le nom de fichier. Phase initialize : disponible
                         à default-compile (les deps Java Modules forcent le mode module-path)
                         et à compile-module-info en prepare-package. -->
                    <execution>
                        <id>copy-deps-to-module-path</id>
                        <phase>initialize</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/javamodules</outputDirectory>
                            <includeScope>test</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- -p javamodules appliqué à toutes les executions sauf override.
                         Nécessaire car maven-compiler-plugin 4.0.0-beta-4 active le mode
                         Java Modules dès qu'une dep est nommée module (humboldt-api etc.) — il
                         faut alors lui dire où trouver microprofile-rest-client-api
                         (JAR sans Automatic-Module-Name, copié par dependency-plugin). -->
                    <compilerArgs>
                        <arg>-p</arg>
                        <arg>${project.build.directory}/javamodules</arg>
                        <!-- Library module: cross-module beans are validated at the
                             Vidocq runtime assembly, not here (pattern knock-jaxrs). -->
                        <arg>-Avauban.validation=false</arg>
                    </compilerArgs>
                    <!-- Vauban indexer APT: generates META-INF/vauban-beans.list and the
                         _VaubanComponents provider so the @Provider tracing filters
                         self-register as CDI beans in a Vauban-based runtime. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.vidocq.vauban</groupId>
                            <artifactId>vauban-processor</artifactId>
                            <version>${vauban.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <execution>
                        <id>compile-module-info</id>
                        <phase>prepare-package</phase>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/main/module-info</compileSourceRoot>
                            </compileSourceRoots>
                            <compilerArgs>
                                <arg>-p</arg>
                                <arg>${project.build.directory}/javamodules</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
