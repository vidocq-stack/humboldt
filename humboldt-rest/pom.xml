<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>io.vidocq.humboldt</groupId>
        <artifactId>humboldt-parent</artifactId>
    </parent>

    <artifactId>humboldt-rest</artifactId>
    <name>Humboldt :: REST</name>
    <description>Filters JAX-RS pour instrumentation HTTP serveur : extract W3C TraceContext, span SERVER, conventions OTel HTTP semantic.</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.humboldt</groupId>
            <artifactId>humboldt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.humboldt</groupId>
            <artifactId>humboldt-sdk-trace</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.humboldt</groupId>
            <artifactId>humboldt-propagator-w3c</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.humboldt</groupId>
            <artifactId>humboldt-otel-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.humboldt</groupId>
            <artifactId>humboldt-otel-context</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
        </dependency>
        <!-- M7c.12 — MicroProfile Rest Client API : optionnel (scope provided).
             Le HumboldtMpRestClientListener n'est invoqué que si MP Rest Client est
             effectivement présent en runtime (typiquement via cyrano-core dans le
             classpath de l'app). Permet l'auto-instrumentation des Rest Client
             créés via @RegisterRestClient/RestClientBuilder. -->
        <dependency>
            <groupId>org.eclipse.microprofile.rest.client</groupId>
            <artifactId>microprofile-rest-client-api</artifactId>
            <version>4.0</version>
            <optional>true</optional>
        </dependency>
        <!-- jakarta.annotation pour @Priority sur HumboldtSpanFinalizer.
             Petite dep API standard, requise par la sémantique JAX-RS pour
             les ExceptionMapper priorités. -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
            JPMS workaround pour microprofile-rest-client-api:4.0 qui n'a pas
            d'Automatic-Module-Name dans son MANIFEST.MF. Le nom JPMS dérivé du fichier
            est microprofile.rest.client.api, mais Maven 4 + maven-compiler-plugin
            4.0.0-beta-4 ne place pas ce JAR sur le module-path par défaut.

            Solution alignée sur cyrano (cf. cyrano/pom.xml) : maven-dependency-plugin
            copie tous les JARs compile-scope dans target/javamodules/ en phase initialize.
            maven-compiler-plugin reçoit l'argument module-path = target/javamodules ;
            javac dérive alors le nom microprofile.rest.client.api depuis le nom de fichier.
        -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-compile-deps-to-module-path</id>
                        <phase>initialize</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/javamodules</outputDirectory>
                            <includeScope>compile</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-p</arg>
                        <arg>${project.build.directory}/javamodules</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
